# Tmux plugins directory
tmux/.config/tmux/plugins/*
# But keep the directory structure
!tmux/.config/tmux/plugins/.gitkeep

# Python cache
__pycache__/
*.py[cod]

# Local config (contains sensitive data)
.gitconfig.local

# Editor typings herdr-app writes into each mod folder
herdr-app/.config/herdr-app/mods/*/gpui-kit.d.ts
herdr-app/.config/herdr-app/mods/*/jsconfig.json
